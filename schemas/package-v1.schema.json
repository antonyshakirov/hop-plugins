{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hop plugin package v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "manifest",
    "code"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "apiVersion",
        "name",
        "description",
        "author",
        "capabilities",
        "settings"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "apiVersion": {
          "const": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 5,
          "items": {
            "enum": [
              "ui.theme",
              "ui.panel",
              "timer.read",
              "timer.control",
              "system.read"
            ]
          }
        },
        "settings": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "label",
              "type",
              "default"
            ],
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,63}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "type": {
                "enum": [
                  "string",
                  "boolean",
                  "integer"
                ]
              },
              "default": {
                "type": [
                  "string",
                  "boolean",
                  "integer"
                ]
              },
              "min": {
                "type": "integer"
              },
              "max": {
                "type": "integer"
              }
            }
          }
        }
      }
    },
    "code": {
      "type": "string"
    }
  }
}
