{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hop plugin catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "revision",
    "plugins",
    "revokedSha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "plugins": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "apiVersion",
          "name",
          "description",
          "author",
          "capabilities",
          "packageURL",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "apiVersion": {
            "const": 1
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "author": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "capabilities": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 5,
            "items": {
              "enum": [
                "ui.theme",
                "ui.panel",
                "timer.read",
                "timer.control",
                "system.read"
              ]
            }
          },
          "packageURL": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://raw\\.githubusercontent\\.com/antonyshakirov/hop-plugins/main/packages/"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "revokedSha256": {
      "type": "array",
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    }
  }
}
